{
  "schemaVersion": 1,
  "id": "fabric_hello",
  "version": "${version}",
  "name": "Fabric Hello",
  "description": "NeFobric V0.0.1 Alpha 的 Fabric 测试模组。",
  "license": "MIT",
  "authors": ["NeFobric"],
  "contact": {"homepage": "https://github.com/drangonmc/NeFobric"},
  "icon": "assets/fabric_hello/icon.png",
  "environment": "*",
  "entrypoints": {
    "preLaunch": ["dev.nefobric.testmods.fabric.FabricHello"],
    "main": ["dev.nefobric.testmods.fabric.FabricHello"],
    "client": ["dev.nefobric.testmods.fabric.FabricHello"],
    "server": ["dev.nefobric.testmods.fabric.FabricHello"],
    "fabric_hello:probe": [
      "dev.nefobric.testmods.fabric.ApiProbe::run",
      "dev.nefobric.testmods.fabric.ApiProbe::FIELD"
    ]
  },
  "mixins": ["fabric_hello.mixins.json"],
  "custom": {
    "fabric_hello:probe": {"answer": 42, "list": ["a"]}
  },
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "~1.20.1",
    "java": ">=17"
  }
}
